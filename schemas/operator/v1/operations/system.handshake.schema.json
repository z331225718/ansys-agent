{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aedt-agent:operator:v1:operation:system.handshake",
  "type": "object",
  "additionalProperties": false,
  "required": ["client"],
  "properties": {
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "schema_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "schema_version": {"const": "1.0"},
        "schema_bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "requested_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 30,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    }
  },
  "$defs": {"successData": {"$anchor": "successData", "$ref": "urn:aedt-agent:operator:v1:common#/$defs/handshakeResult"}}
}
