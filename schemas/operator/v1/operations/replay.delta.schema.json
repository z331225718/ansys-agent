{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aedt-agent:operator:v1:operation:replay.delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_run_id"],
  "properties": {
    "graph_run_id": {"$ref": "urn:aedt-agent:operator:v1:common#/$defs/opaqueId"},
    "after_cursor": {"anyOf": [{"type": "string", "pattern": "^[0-9]+$", "maxLength": 200}, {"type": "null"}]},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100}
  },
  "$defs": {"successData": {"$anchor": "successData", "$ref": "urn:aedt-agent:operator:v1:common#/$defs/replayResult"}}
}
