{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aedt-agent:operator:v1:envelope",
  "title": "Operator Protocol v1 Envelope",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"},
    {"$ref": "#/$defs/event"}
  ],
  "$defs": {
    "schemaVersion": {"const": "1.0"},
    "uuid": {"type": "string", "format": "uuid"},
    "operation": {
      "enum": [
        "system.handshake",
        "template.catalog",
        "system.preflight",
        "graph.status",
        "replay.delta",
        "graph.visualize",
        "artifact.query_bounded",
        "approval.get_pending",
        "approval.prepare_decision",
        "mission.start",
        "graph.advance",
        "intervention.apply",
        "graph.stop.prepare"
      ]
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pi_session_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "pi_tool_call_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mission_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "graph_run_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "event_cursor": {"type": "string", "minLength": 1, "maxLength": 200},
        "state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "enum": [
            "invalid_argument",
            "invalid_cursor",
            "not_found",
            "unsupported_operation",
            "protocol_error",
            "outcome_unknown",
            "unsafe_profile",
            "approval_required",
            "stale_cursor",
            "idempotency_conflict",
            "busy",
            "timeout",
            "transient",
            "terminal_failed",
            "internal"
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 1000},
        "retryable": {"type": "boolean"},
        "details": {"type": "object", "maxProperties": 30}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "request_id",
        "trace_id",
        "operation",
        "sent_at",
        "arguments"
      ],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "type": {"const": "request"},
        "request_id": {"$ref": "#/$defs/uuid"},
        "trace_id": {"$ref": "#/$defs/uuid"},
        "operation": {"$ref": "#/$defs/operation"},
        "sent_at": {"type": "string", "format": "date-time"},
        "caller": {"$ref": "#/$defs/caller"},
        "arguments": {"type": "object"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "request_id",
        "trace_id",
        "operation",
        "ok",
        "completed_at",
        "resource",
        "data",
        "error"
      ],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "type": {"const": "response"},
        "request_id": {"$ref": "#/$defs/uuid"},
        "trace_id": {"$ref": "#/$defs/uuid"},
        "operation": {"$ref": "#/$defs/operation"},
        "ok": {"type": "boolean"},
        "completed_at": {"type": "string", "format": "date-time"},
        "resource": {"anyOf": [{"$ref": "#/$defs/resource"}, {"type": "null"}]},
        "data": {},
        "error": {"anyOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"ok": {"const": true}}},
          "then": {"properties": {"error": {"type": "null"}}}
        },
        {
          "if": {"properties": {"ok": {"const": false}}},
          "then": {
            "properties": {
              "data": {"type": "null"},
              "error": {"$ref": "#/$defs/error"}
            },
            "required": ["error"]
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "request_id",
        "trace_id",
        "operation",
        "event",
        "sequence",
        "occurred_at",
        "data"
      ],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "type": {"const": "event"},
        "request_id": {"$ref": "#/$defs/uuid"},
        "trace_id": {"$ref": "#/$defs/uuid"},
        "operation": {"$ref": "#/$defs/operation"},
        "event": {"enum": ["progress"]},
        "sequence": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "data": {"type": "object", "maxProperties": 30}
      }
    }
  }
}
