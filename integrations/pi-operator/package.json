{
  "name": "@aedt-agent/pi-operator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contract-drift": "npm run generate:contracts && git diff --exit-code -- src/generated/operator-v1.ts",
    "build": "tsc --project tsconfig.json && node scripts/copy-resources.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev",
    "test": "npm run build && node --test dist/test/*.test.js",
    "gate:readonly": "npm run build && node dist/scripts/run-readonly-gate.js",
    "gate:p3-windows-evidence": "npm run build && node dist/scripts/run-p3-windows-evidence.js",
    "recovery:clear-stale-lease": "npm run build && node dist/scripts/clear-stale-session-lease.js",
    "start:observer": "npm run build && node dist/src/main.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
